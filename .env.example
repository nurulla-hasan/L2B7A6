# Application Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_PREFIX=/api/v1
APP_NAME=Academic Backend API

# Database & CORS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_db?schema=public
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Security & Rate Limiting
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

# JWT Configuration
JWT_ACCESS_SECRET=super-secret-access-token-key-must-be-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-token-key-must-be-at-least-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Redis (Optional in local dev, fallback in-memory cache provided)
REDIS_URL=redis://localhost:6379
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=3

# SMTP Email Configuration (Optional in dev - prints OTP to console if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Academic Portal <no-reply@example.com>

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default Super Admin Seed Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Super Admin
ADMIN_PASSWORD=11111111

